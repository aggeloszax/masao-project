DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
INTERNAL_API_KEY=replace-with-a-long-random-render-secret
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-8
ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=https://masao.onrender.com,https://masao.vercel.app
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
RATE_LIMIT_BACKEND=redis
CHAT_IP_RATE_LIMIT_REQUESTS=120
REDIS_URL=rediss://USER:PASSWORD@HOST:PORT/0
REDIS_KEY_PREFIX=masao
RATE_LIMIT_FAIL_CLOSED=true
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
CHAT_RETENTION_DAYS=30

# --- Take-away orders ---
# Κλειδί από Brevo → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-your_key_here
# Ποιοι λαμβάνουν τις παραγγελίες· για περισσότερους, χωρίστε με κόμμα.
ORDER_NOTIFICATION_EMAIL=owner@example.com,second@example.com
# Ο αποστολέας: σκέτη διεύθυνση, επαληθευμένη στο Brevo → Senders.
# Δεν χρειάζεται domain. Στέλνει σε οποιονδήποτε παραλήπτη.
ORDER_FROM_EMAIL=you@example.com
ORDER_FROM_NAME=Masao

