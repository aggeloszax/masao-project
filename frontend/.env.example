NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin (/admin) ---
# Κοινός κωδικός για τον πίνακα διαχείρισης.
ADMIN_PASSWORD=replace-with-a-long-random-passphrase
# Προαιρετικό: ξεχωριστό κλειδί υπογραφής για το session cookie.
# Αν λείπει, υπογράφει ο ίδιος ο ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
# Πρέπει να ταυτίζεται με το INTERNAL_API_KEY του backend. Μένει server-side.
INTERNAL_API_KEY=replace-with-a-long-random-render-secret
